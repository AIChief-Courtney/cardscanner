# Pooled connection (Supabase transaction pooler, port 6543) — use for the app / Prisma Client
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — use for Prisma migrations (`npm run db:migrate`)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Local Postgres example (optional dev without Supabase):
# DATABASE_URL="postgresql://cardscanner:cardscanner@localhost:5435/cardscanner?schema=public"
# DIRECT_URL="postgresql://cardscanner:cardscanner@localhost:5435/cardscanner?schema=public"

AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Must match the origin in your browser when signing up (scheme + host + port)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional — for future Supabase Auth / Storage / client SDK (Project Settings → API)
# NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."