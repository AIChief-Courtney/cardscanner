generator client {

  provider = "prisma-client-js"

}



datasource db {

  provider  = "postgresql"

  url       = env("DATABASE_URL")

  directUrl = env("DIRECT_URL")

}



model User {

  id           String   @id @default(cuid())

  email        String   @unique

  passwordHash String

  /// 0 = user, 1 = admin

  role         Int      @default(0)

  /// Account balance in US dollars

  balanceUsd   Decimal  @default(0) @db.Decimal(18, 2)

  createdAt    DateTime @default(now())

}
